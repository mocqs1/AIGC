LIBLIB_API_KEY=
HERMES_API_URL=https://aiapi.yicheng.bj.cn/v1
HERMES_API_KEY=
HERMES_MODEL=gpt-image-2
HERMES_SUBMIT_PATH=/images/generations
HERMES_STATUS_PATH=/images/generations/{task_id}
HERMES_RESULT_PATH=/images/generations/{task_id}
HERMES_TIMEOUT=480
# Optional operator-only network route for Codex Terra. Environment proxy
# variables remain ignored. The proxy must be a credential-free loopback HTTP
# proxy. Set a public pinned IP when local DNS cannot resolve the API hostname.
CODEX_TERRA_PROXY_URL=
CODEX_TERRA_PINNED_IP=
VIDEO_API_KEY=
# Native Google Veo uses the Gemini API by default. The AI Studio page URL is
# not an API endpoint. Set VEO_API_MODE=gateway only for a custom task gateway.
VEO_API_KEY=
VEO_API_MODE=native
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_API_URL=
VEO_SUBMIT_PATH=/v1/videos
VEO_STATUS_PATH=/v1/videos/{task_id}
VEO_RESULT_PATH=/v1/videos/{task_id}/result
VEO_AUTH_HEADER=Authorization
VEO_AUTH_SCHEME=Bearer
SEEDANCE_API_KEY=
# Volcengine Ark Seedance. Use the API key created in the Ark console.
SEEDANCE_API_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_TEXT_MODEL=doubao-seedance-2-0-260128
SEEDANCE_IMAGE_MODEL=doubao-seedance-2-0-260128
SEEDANCE_SUBMIT_PATH=/contents/generations/tasks
SEEDANCE_STATUS_PATH=/contents/generations/tasks/{task_id}
SEEDANCE_RESULT_PATH=/contents/generations/tasks/{task_id}
SEEDANCE_AUTH_HEADER=Authorization
SEEDANCE_AUTH_SCHEME=Bearer
# Optional EvoLink compatibility upload settings; Ark accepts data URLs directly.
SEEDANCE_UPLOAD_API_URL=https://files-api.evolink.ai
SEEDANCE_UPLOAD_PATH=/api/v1/files/upload/base64

# Cloudflare R2 S3-compatible storage. Keep real values only in .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://img.example.com
# Optional upload limit in bytes (default: 500 MiB).
R2_MAX_FILE_SIZE_BYTES=524288000
