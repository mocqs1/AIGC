.env
.env.*
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.coverage
htmlcov/
/.runtime/
/.agents/
*.key
.aigc_studio_*.json

/web/node_modules/
/web/dist/

# Generated media and local studio state are never release artifacts.
/outputs/*
!/outputs/images/
!/outputs/videos/
/outputs/images/*
/outputs/videos/*
!/outputs/images/.gitkeep
!/outputs/videos/.gitkeep

# Local inputs, imported assets, and leftover run folders stay off git.
/input/*
!/input/.gitkeep
/output/*
!/output/images/
!/output/videos/
/output/images/*
/output/videos/*
!/output/images/.gitkeep
!/output/videos/.gitkeep
/clothing_image/
/images/
/imported/
/shapewear/
/videos/

*.log
*.pid
